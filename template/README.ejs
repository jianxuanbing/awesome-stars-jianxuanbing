  index++
) {
  const repository = displayedRepositories[index];
  const name = repository.full_name;
  const url = repository.html_url;
  const description = cleanText(repository.description);
  const starCount = Number(repository.stargazers_count || 0);

  const topics = (repository.topics || [])
    .slice(0, MAX_TOPICS)
    .map(topic => `\`${cleanText(topic, 30)}\``)
    .join(' ');

  const updated = formatDateTime(repository.updated_at);

  const updatedAtTime =
    new Date(repository.updated_at || 0).getTime();

  const activeDays = Number.isNaN(updatedAtTime)
    ? Number.MAX_SAFE_INTEGER
    : (Date.now() - updatedAtTime) / (1000 * 60 * 60 * 24);

  const activeMark = activeDays <= 30 ? '🔥 ' : '';
