<%
const MAX_ITEMS_PER_LANGUAGE = 50;
const MAX_DESCRIPTION_LENGTH = 160;
const MAX_TOPICS = 5;

function formatDateTime(input) {
  const date = new Date(input);

  if (Number.isNaN(date.getTime())) {
    return '';
  }

  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getDate()).padStart(2, '0')
  ].join('-') + ' ' + [
    String(date.getHours()).padStart(2, '0'),
    String(date.getMinutes()).padStart(2, '0'),
    String(date.getSeconds()).padStart(2, '0')
  ].join(':');
}

function cleanText(input, maxLength = MAX_DESCRIPTION_LENGTH) {
  const value = String(input || '')
    .replace(/\r?\n/g, ' ')
    .replace(/\|/g, '\\|')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\s+/g, ' ')
    .trim();

  if (value.length <= maxLength) {
    return value;
  }

  return `${value.slice(0, maxLength - 1)}…`;
}

function createAnchor(value) {
  return `language-${Array.from(String(value))
    .map(character => character.codePointAt(0).toString(16))
    .join('-')}`;
}

/**
 * 仓库排序规则：
 * 1. Star 数量降序；
 * 2. Star 数相同时，按最后更新时间降序。
 */
function sortRepositories(repositories) {
  return [...repositories].sort((left, right) => {
    const leftStars = Number(left.stargazers_count || 0);
    const rightStars = Number(right.stargazers_count || 0);

    if (rightStars !== leftStars) {
      return rightStars - leftStars;
    }

    const leftUpdatedAt = new Date(left.updated_at || 0).getTime();
    const rightUpdatedAt = new Date(right.updated_at || 0).getTime();

    return rightUpdatedAt - leftUpdatedAt;
  });
}

function getDisplayedRepositories(repositories) {
  return sortRepositories(repositories)
    .slice(0, MAX_ITEMS_PER_LANGUAGE);
}

let totalCount = 0;
let displayedCount = 0;

for (const [, repositories] of stars) {
  totalCount += repositories.length;
  displayedCount += Math.min(
    repositories.length,
    MAX_ITEMS_PER_LANGUAGE
  );
}

const generatedAt = formatDateTime(updatedAt || Date.now());
const badgeDate = generatedAt.substring(0, 10);
%>

